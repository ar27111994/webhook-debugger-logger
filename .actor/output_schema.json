{
  "actorOutputSchemaVersion": 1,
  "title": "Webhook Debugger Output",
  "properties": {
    "dataset": {
      "type": "string",
      "title": "Captured Events (Live)",
      "template": "{{links.apiDefaultDatasetUrl}}/items"
    },
    "info": {
      "type": "string",
      "title": "Active Webhooks Info",
      "template": "{{links.containerRunUrl}}/info"
    },
    "webhooks": {
      "type": "string",
      "title": "Storage State",
      "template": "{{links.apiDefaultKeyValueStoreUrl}}/keys"
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "timestamp",
          "requestId",
          "signatureValid",
          "webhookId",
          "method",
          "statusCode",
          "contentType",
          "size",
          "processingTime",
          "processingTimeUs",
          "responseMode",
          "ackMs",
          "scriptMs",
          "backgroundTotalMs",
          "remoteIp",
          "signatureProvider"
        ],
        "desc": true
      },
      "display": {
        "component": "table",
        "properties": {
          "processingTime": {
            "label": "Processing Time (ms)",
            "format": "number"
          },
          "processingTimeUs": {
            "label": "Processing Time (μs)",
            "format": "number"
          },
          "responseMode": {
            "label": "Mode"
          },
          "ackMs": {
            "label": "Ack (ms)",
            "format": "number"
          },
          "scriptMs": {
            "label": "Script (ms)",
            "format": "number"
          },
          "backgroundTotalMs": {
            "label": "Background (ms)",
            "format": "number"
          }
        }
      }
    },
    "details": {
      "title": "Full Payloads",
      "transformation": {
        "fields": [
          "timestamp",
          "requestId",
          "signatureValid",
          "method",
          "statusCode",
          "headers",
          "body",
          "responseBody",
          "responseHeaders",
          "signatureProvider",
          "signatureError",
          "responseMode",
          "asyncEnrichment",
          "scriptDemotedToAsync",
          "authMs",
          "bodyPrepMs",
          "schemaMs",
          "signatureMs",
          "scriptMs",
          "ackMs",
          "pushDataMs",
          "duckdbMs",
          "forwardMs",
          "backgroundTotalMs"
        ],
        "desc": true
      },
      "display": {
        "component": "table"
      }
    }
  }
}
